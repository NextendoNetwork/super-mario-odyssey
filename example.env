# Copy to .env (or pass via systemd EnvironmentFile=) and fill in real values.
# See main.go for what each knob actually does; only the unverified ones are listed here.

# --- Identity / NEX ---
# SMO_ACCESS_KEY and the game server ID (255BA201, baked into main.go) are from the kinnay
# wiki's Game Server List, not independently confirmed against a real Odyssey binary dump --
# override here if a capture ever shows otherwise.
SMO_ACCESS_KEY=afef0ecf
# NOT confirmed on the wire -- best-precedented guess (see main.go's comment). Try 40000 first;
# if LoginEx never completes, this is the first thing to suspect.
SMO_NEX_VERSION=40000

# --- Network ---
# Set this to your own server's real public IP.
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=8453
SECURE_PORT=60013
OBJECT_PORT=8459
DASH_PORT=8089
DASH_TOKEN=

# --- TLS (shared self-signed pair every Nextendo game server on this box uses) ---
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Account / gates (same as every other title -- see gates.go) ---
NEXTENDO_ACCOUNT_URL=http://nextendo-account:8080
NEXTENDO_INTERNAL_KEY=
NEXTENDO_SECRET_FILE=nextendo_secret.key
NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Unverified wire-shape knobs (see main.go) ---
SMO_STATION_SCHEME=prudps
SMO_SECURE_MINOR=0

# --- Storage ---
SMO_DATASTORE_FILE=smo_datastore.json
SMO_BLOB_DIR=smo_blobs

# --- Dashboard aggregator ---
SMO_SNI_HOST=
